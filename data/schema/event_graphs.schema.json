{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysteries-life-sim/event_graphs.schema.json",
  "title": "事件图数据 Schema",
  "description": "校验 data/event_graphs.json：图、节点、边、条件、选择的结构与字段白名单",
  "type": "array",
  "items": { "$ref": "#/$defs/graph" },
  "$defs": {
    "graph": {
      "type": "object",
      "required": ["id", "nodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "start_node": { "type": "string" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "chance": { "type": "integer", "minimum": 0, "maximum": 100 },
        "weight": { "type": "integer", "minimum": 0 },
        "cooldown": { "type": "integer", "minimum": 0 },
        "repeatable": { "type": "boolean" },
        "locations": { "type": "array", "items": { "type": "string" } },
        "location": { "type": "string" },
        "min_day": { "type": "integer", "minimum": 0 },
        "max_day": { "type": "integer", "minimum": 0 },
        "season": { "type": "string" },
        "months": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
        "jobs": { "type": "array", "items": { "type": "string" } },
        "min_madness": { "type": "integer", "minimum": 0 },
        "min_spirituality": { "type": "integer", "minimum": 0 },
        "requires_clues": { "type": "array", "items": { "type": "string" } },
        "requires_any_clue": { "type": "array", "items": { "type": "string" } },
        "requires_tags_any": { "type": "array", "items": { "type": "string" } },
        "requires_contacts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "after_nodes": { "type": "array", "items": { "type": "string" } },
        "once_tag": { "type": "string" },
        "on_world_event": { "type": "string" },
        "on_world_event_cond": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "add_tags": { "type": "array", "items": { "type": "string" } },
        "add_clues": { "$ref": "#/$defs/clueList" },
        "effects": { "$ref": "#/$defs/effects" },
        "trust_effects": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/choice" }
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": ["label", "result"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "branch_to": { "type": "string" },
        "effects": { "$ref": "#/$defs/effects" },
        "add_tags": { "type": "array", "items": { "type": "string" } },
        "add_clues": { "$ref": "#/$defs/clueList" },
        "trust_effects": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      },
      "additionalProperties": false
    },
    "clueList": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id", "title", "text"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "text": { "type": "string" },
              "location": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "effects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z_]+$"
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "integer" },
          { "type": "string" }
        ]
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "condition": { "$ref": "#/$defs/combined" }
      }
    },
    "combined": {
      "type": "object",
      "additionalProperties": true
    }
  }
}